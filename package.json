{
  "name": "galerie-infinie",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json",
    "worker:dev": "tsx scripts/dev-worker.ts",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "try:adapters": "tsx scripts/try-adapters.ts",
    "test:leak": "node scripts/leak-test.mjs",
    "emulators": "bash scripts/emulators.sh"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/three": "^0.186.0",
    "firebase-tools": "^15.33.0",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
